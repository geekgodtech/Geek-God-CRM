        Log("AdjustLayout ABORTED: One or more views are not initialized.")
        Return
    End If
    
    LastAppliedWidth = Width
    
    ' Calculate the anchor point for the list view
    Dim HeaderBottom As Int = spnChose.Top + spnChose.Height
    Log("HeaderBottom calculated at: " & HeaderBottom)
    
    ' Spy on the List Movement
